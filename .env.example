FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=change-me
FALKORDB_GRAPH=lineage
# Chat + embeddings providers (free tiers). Pick the model names with: uv run --env-file .env python scripts/pick_models.py --write
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBED_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
# Seconds between LLM requests (free-tier pacing; it slows itself down further after a 429)
LLM_MIN_INTERVAL=5
# Optional generic OpenAI-compatible endpoint, used only if neither provider above is configured:
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBED_MODEL=
GITHUB_TOKEN=

# Deployment (docker compose)
# Browser origins allowed to call the API, comma-separated (your Vercel URL in production):
CORS_ORIGINS=http://localhost:5173
API_PORT=8000
